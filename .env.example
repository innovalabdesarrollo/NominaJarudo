# MongoDB Atlas — el nombre de DB va en la URI (nomina_jarudo). No mezclar otras DBs.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/nomina_jarudo?retryWrites=true&w=majority

# API local — puerto dedicado. Si está ocupado, NO mates el otro proceso: cambia PORT.
PORT=3088
HOST=127.0.0.1

# Web (SvelteKit / Vite)
WEB_PORT=5288
CORS_ORIGIN=http://127.0.0.1:5288,http://localhost:5288

# Cliente → API
# - Local dual: http://127.0.0.1:3088
# - Vercel (mismo origen): dejar VACÍO
PUBLIC_API_URL=http://127.0.0.1:3088

UPLOAD_DIR=./uploads

# Auth local (sin Google / sin correo)
JWT_SECRET=

# PDF SAP: sin API externa. Formatos: Folio|Fecha|Operador|Placa|Volumen|Estado, etc.

# --- Vercel (dashboard; no commitear secretos) ---
# MONGODB_URI, JWT_SECRET
# PUBLIC_API_URL=   (vacío)
# Root Directory = apps/web
# Ver DEPLOY-VERCEL.md
